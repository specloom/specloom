{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "allowJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "paths": {
      "~/*": ["./src/*"],
      "specloom": ["../../packages/specloom/src/index.ts"],
      "@specloom/solidjs": ["../../packages/solidjs/src/index.ts"],
      "@specloom/spec": ["../../packages/spec/src/index.ts"],
      "@specloom/data-provider": ["../../packages/data-provider/src/index.ts"],
      "@specloom/auth-provider": ["../../packages/auth-provider/src/index.ts"],
    },
  },
  "exclude": ["prisma", "prisma.config.ts", "src/lib/db.ts", "vite.config.ts"],
}
