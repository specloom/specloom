{
  "name": "@specloom/typespec",
  "version": "1.0.0",
  "description": "TypeSpec decorators and emitter for specloom spec v1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "lib"
  ],
  "typespec": "./lib/main.tsp",
  "dependencies": {
    "@specloom/spec": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "test": "../../node_modules/.bin/vitest run"
  },
  "keywords": [
    "typespec",
    "specloom",
    "admin",
    "compiled"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@typespec/compiler": ">=0.60.0"
  },
  "devDependencies": {
    "@typespec/compiler": "^0.64.0",
    "typescript": "^5.7.0",
    "vitest": "4.0.17"
  }
}
