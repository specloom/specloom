{
  "name": "@specloom/spec",
  "version": "1.0.0",
  "description": "Shared spec contract for specloom v1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "specloom",
    "spec",
    "schema",
    "types"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
