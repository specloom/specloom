{
  "name": "specloom",
  "version": "1.0.0",
  "description": "Headless admin runtime for specloom spec v1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "test": "../../node_modules/.bin/vitest run"
  },
  "keywords": [
    "specloom",
    "admin",
    "runtime",
    "viewmodel"
  ],
  "license": "MIT",
  "dependencies": {
    "@specloom/spec": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "4.0.17"
  }
}
